{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/cron",
      "dest": "api/cron.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "methods": ["POST"],
      "dest": "api/index.py"
    },
    {
      "src": "/itinerary-route-map.png",
      "dest": "/public/itinerary-route-map.png"
    },
    {
      "src": "/family-bateaux-parisiens-sightseeing-cruise/itinerary-route-map.png",
      "dest": "/public/itinerary-route-map.png"
    },
    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/script.js",
      "dest": "/public/script.js"
    },
    {
      "src": "/family-bateaux-parisiens-sightseeing-cruise/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/family-bateaux-parisiens-sightseeing-cruise/script.js",
      "dest": "/public/script.js"
    },
    {
      "src": "/family-bateaux-parisiens-sightseeing-cruise/?",
      "dest": "/public/index.html"
    },
    {
      "src": "/family-cruise",
      "dest": "/public/index.html"
    },
    {
      "src": "/paris-family-cruise",
      "dest": "/public/index.html"
    },
    {
      "src": "/general-bateaux-parisiens-sightseeing-cruise/styles.css",
      "dest": "/public/sightseeing/styles.css"
    },
    {
      "src": "/general-bateaux-parisiens-sightseeing-cruise/script.js",
      "dest": "/public/sightseeing/script.js"
    },
    {
      "src": "/general-bateaux-parisiens-sightseeing-cruise/?",
      "dest": "/public/sightseeing/index.html"
    },
    {
      "src": "/general-sightseeing-cruise/?",
      "dest": "/public/sightseeing/index.html"
    },
    {
      "src": "/general-paris-sightseeing-cruise/?",
      "dest": "/public/sightseeing/index.html"
    },
    {
      "src": "/bateaux-parisiens-sightseeing-cruise/styles.css",
      "dest": "/public/sightseeing/styles.css"
    },
    {
      "src": "/bateaux-parisiens-sightseeing-cruise/script.js",
      "dest": "/public/sightseeing/script.js"
    },
    {
      "src": "/bateaux-parisiens-sightseeing-cruise/?",
      "dest": "/public/sightseeing/index.html"
    },
    {
      "src": "/paris-sightseeing-cruise/?",
      "dest": "/public/sightseeing/index.html"
    },
    {
      "src": "/sightseeing-cruise/?",
      "dest": "/public/sightseeing/index.html"
    },
    {
      "src": "/sightseeing/styles.css",
      "dest": "/public/sightseeing/styles.css"
    },
    {
      "src": "/sightseeing/script.js",
      "dest": "/public/sightseeing/script.js"
    },
    {
      "src": "/sightseeing/?",
      "dest": "/public/sightseeing/index.html"
    },
    {
      "src": "/couples-bateaux-mouches-dinner-cruise/styles.css",
      "dest": "/public/dinner/styles.css"
    },
    {
      "src": "/couples-bateaux-mouches-dinner-cruise/script.js",
      "dest": "/public/dinner/script.js"
    },
    {
      "src": "/couples-bateaux-mouches-dinner-cruise/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/couples-paris-dinner-cruise-bateaux-mouches/styles.css",
      "dest": "/public/dinner/styles.css"
    },
    {
      "src": "/couples-paris-dinner-cruise-bateaux-mouches/script.js",
      "dest": "/public/dinner/script.js"
    },
    {
      "src": "/couples-paris-dinner-cruise-bateaux-mouches/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/couples-dinner-cruise/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/bateaux-mouches-dinner-cruise/styles.css",
      "dest": "/public/dinner/styles.css"
    },
    {
      "src": "/bateaux-mouches-dinner-cruise/script.js",
      "dest": "/public/dinner/script.js"
    },
    {
      "src": "/bateaux-mouches-dinner-cruise/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/paris-dinner-cruise-bateaux-mouches/styles.css",
      "dest": "/public/dinner/styles.css"
    },
    {
      "src": "/paris-dinner-cruise-bateaux-mouches/script.js",
      "dest": "/public/dinner/script.js"
    },
    {
      "src": "/paris-dinner-cruise-bateaux-mouches/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/paris-dinner-cruise/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/dinner-cruise/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/dinner/styles.css",
      "dest": "/public/dinner/styles.css"
    },
    {
      "src": "/dinner/script.js",
      "dest": "/public/dinner/script.js"
    },
    {
      "src": "/dinner/?",
      "dest": "/public/dinner/index.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?sync=1",
      "schedule": "0 20 * * *"
    }
  ]
}